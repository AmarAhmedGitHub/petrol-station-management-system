[Unit]
Description=Petrol Station Management System
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=simple
User=petrol-user
Group=petrol-user
WorkingDirectory=/opt/petrol-station
Environment=PATH=/opt/petrol-station/venv/bin
Environment=STREAMLIT_SERVER_PORT=8501
Environment=STREAMLIT_SERVER_HEADLESS=true
Environment=STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
Environment=STREAMLIT_SERVER_ADDRESS=127.0.0.1
ExecStart=/opt/petrol-station/venv/bin/streamlit run main_app.py --server.port 8501 --server.address 127.0.0.1 --server.headless true
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=petrol-station

# Security settings
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/petrol-station /var/log/petrol-station /var/backups/petrol-station
ProtectHome=yes

# Resource limits
MemoryLimit=1G
CPUQuota=80%

[Install]
WantedBy=multi-user.target
